                <mxCell id="5886" value="30) Creamos mart.Animal_Farm_PE&lt;div&gt;&lt;div&gt;SELECT DISTINCT&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; COALESCE(NULLIF(t1.WWNCA, &#39;&#39;),&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;t2.WWNCA)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AS WWNCA,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; COALESCE(NULLIF(t1.CATEGORY_NAME, &#39;&#39;), t2.CATEGORY_NAME) AS CATEGORY_NAME,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.MATERIAL,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.MATERIAL_DESC,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.ORDENES_MEAN,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.VOL_P70,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.VOLUMEN,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.VOLATILIDAD,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.Vol_treshold,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.History_Status,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.min_date,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.max_date,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; t1.Animal_Class,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; CASE&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 6 THEN &#39;000000000000&#39;&amp;nbsp; || TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 7 THEN &#39;00000000000&#39;&amp;nbsp; &amp;nbsp;|| TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 8 THEN &#39;0000000000&#39;&amp;nbsp; &amp;nbsp; || TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ELSE NULL&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; END&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AS MATERIAL2,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; COALESCE(&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; CASE&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 6 THEN &#39;000000000000&#39;&amp;nbsp; || TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 7 THEN &#39;00000000000&#39;&amp;nbsp; &amp;nbsp;|| TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; WHEN LENGTH(TRIM(CAST(t1.MATERIAL AS VARCHAR))) = 8 THEN &#39;0000000000&#39;&amp;nbsp; &amp;nbsp; || TRIM(CAST(t1.MATERIAL AS VARCHAR))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; END,&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &#39;&#39;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; ) || &#39;_&#39; || COALESCE(t1.MATERIAL_DESC, &#39;&#39;)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;AS MAT_DESC&lt;/div&gt;&lt;div&gt;FROM input_animal_5_4AF t1&lt;/div&gt;&lt;div&gt;LEFT JOIN catalogo_skus_desc t2 ON t1.MATERIAL = t2.MATERIAL&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1619">
