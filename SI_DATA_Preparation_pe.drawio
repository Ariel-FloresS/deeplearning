                <mxCell id="982" value="&lt;b&gt;8) Se crea la tabla stg.Factor_conv_PE, haciendo un left join entre la tabla [select t1.*, T2.MAKTX as PPC_DESC from UOM_EA_PUM_PAL_KG as t1 y product_01 as T2 on t1.PPC=T2.MATNR] as T1y la tabla product_01 as T2 on T.MATNR=T2.MATNR&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="633">
