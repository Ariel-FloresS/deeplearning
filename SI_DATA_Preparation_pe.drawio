                <mxCell id="2177" value="&lt;b&gt;Creamos BW_PH_P_M8_PE haciendo left join BW_PH_P_M7_PE (t1) y CATALOGO_PRODUCT_PE (t2)&lt;/b&gt;&lt;div&gt;&lt;b&gt;ON (t1.MATERIAL = t2.MATNR)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;en donde t2.PL2_BUSINESS_ID !=&#39;PEU&#39; y t1.SALESORG != &#39;PE25&#39;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;se crean las columnas:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;MAT_DESC = t1.MATERIAL+&#39;_&#39;+t2.MAKTX&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CL3_DESC = t1._BIC_YCUSTL3+&#39;_&#39;+t1.NAME_L3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;CL4_DESC = t1._BIC_YCUSTL4 +&#39;_&#39;+t1.NAME_L4&lt;/b&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1994">
